#!/usr/bin/env bash
set -euo pipefail

if [ -f scripts/ci/render-env ]; then
  set -a
  # shellcheck disable=SC1091
  . scripts/ci/render-env
  set +a
fi

if [ -z "${GITHUB_ACTIONS:-}" ]; then
  export OPEN_WINDOW="${OPEN_WINDOW:-1}"
fi

summary_only=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --summary-only)
      summary_only=true
      ;;
    -h|--help)
      echo "Usage: scripts/ci/run-playwright-render [--summary-only]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
  shift
done

render_summary() {
  if [ -z "${GITHUB_ACTIONS:-}" ]; then
    echo -e "\n\n\n"
    echo "Plotting metrics..."
    for csv in /tmp/*.csv; do
      [ -f "$csv" ] || continue
      bun scripts/metric_plot.js "$csv"
    done
    echo -e "\n\n\n"
    echo "Combining render images..."
    bun scripts/ci/combine-render-images
    echo -e "\n\n\n"
  fi
}

if [ "$summary_only" = "true" ]; then
  render_summary
  exit 0
fi

attempts="${ATTEMPTS:-2}"
: "${CHOSEN_NAME:?CHOSEN_NAME is required}"
: "${SCREENSHOT_NAME:?SCREENSHOT_NAME is required}"
: "${FPS_SAMPLES_NAME:?FPS_SAMPLES_NAME is required}"
: "${SCENE_METRICS_NAME:?SCENE_METRICS_NAME is required}"
: "${SCENE_METRICS_HEADER:?SCENE_METRICS_HEADER is required}"
GITHUB_ENV="${GITHUB_ENV:-/tmp/render-github-env}"
URLS_JSON="${URLS_JSON:-scripts/ci/render-urls.json}"
STORAGE_STATES_DIR="${STORAGE_STATES_DIR:-scripts/ci/storage-states}"
commit_sha="${GITHUB_SHA:-$(git rev-parse HEAD)}"
commit_sha="${commit_sha:0:10}"
chosen_seen=false

ensure_scene_metrics_header() {
  local path="$1"

  if [ ! -f "$path" ]; then
    printf '%s\n' "$SCENE_METRICS_HEADER" > "$path"
    return
  fi

  local header
  header=$(head -n 1 "$path")
  local needs_commit_sha=false
  [ "$header" = "$SCENE_METRICS_HEADER" ] || needs_commit_sha=true

  {
    printf '%s\n' "$SCENE_METRICS_HEADER"
    if [ "$needs_commit_sha" = "true" ]; then
      tail -n +2 "$path" | awk 'NF && $0 != "undefined" && $0 != "null" {print $0 ", "}'
    else
      tail -n +2 "$path" | awk 'NF && $0 != "undefined" && $0 != "null" {print}'
    fi
  } > "${path}.tmp"
  mv "${path}.tmp" "$path"
}

valid_scene_metrics() {
  local row="$1"

  [ -n "$row" ] && [ "$row" != "undefined" ] && [ "$row" != "null" ]
}

scripts/ci/generate-storage-states "$STORAGE_STATES_DIR" /tmp

while IFS=$'\034' read -r -u 3 name mode url actions state roi; do
  screenshot_path="/tmp/${SCREENSHOT_NAME}_${name}.png"
  fps_samples_path="/tmp/${FPS_SAMPLES_NAME}_${name}.csv"
  scene_metrics_path="/tmp/${SCENE_METRICS_NAME}_${name}.csv"

  for _ in $(seq 1 "$attempts"); do
    fps_args=(
      --name "$name"
      --url "$url"
      --screenshot-path "$screenshot_path"
      --fps-samples-path "$fps_samples_path"
    )
    [ -n "$actions" ] && fps_args+=(--actions "$actions")
    [ -n "$state" ] && fps_args+=(--state "$state")
    [ -n "$roi" ] && fps_args+=(--roi "$roi")

    echo -e "\n\n\n"
    if [ "$mode" = "screenshot" ]; then
      echo "Attempting screenshot via ${url}"
    else
      echo "Attempting FPS check via ${url}"
    fi
    if ! sudo docker compose exec -T web curl -I "${url}" >/dev/null; then
      continue
    fi

    if [ "$mode" = "screenshot" ]; then
      if ! screenshot_output=$(bun scripts/fps.js --screenshot-only "${fps_args[@]}"); then
        echo "${screenshot_output}"
        continue
      fi
      echo "${screenshot_output}"
      continue 2
    fi

    if [ "$mode" = "3d_screenshot" ]; then
      if ! screenshot_output=$(bun scripts/fps.js --screenshot-3d-only "${fps_args[@]}"); then
        echo "${screenshot_output}"
        continue
      fi
      echo "${screenshot_output}"
      continue 2
    fi

    if ! fps_output=$(bun scripts/fps.js "${fps_args[@]}"); then
      echo "${fps_output}"
      continue
    fi
    echo "${fps_output}"

    fps_value=$(echo "${fps_output}" | awk -F= '/^FPS_VALUE=/{print $2; exit}')
    load_duration=$(echo "${fps_output}" | awk -F= '/^LOAD_DURATION=/{print $2; exit}')
    scene_metrics=$(echo "${fps_output}" | awk -F= '/^SCENE_METRICS=/{print $2; exit}')
    if ! valid_scene_metrics "$scene_metrics"; then
      echo "Missing scene metrics for ${url}"
      continue
    fi
    scene_metrics="${scene_metrics}, ${commit_sha}"
    ensure_scene_metrics_header "$scene_metrics_path"
    printf '%s\n' "$scene_metrics" >> "$scene_metrics_path"
    echo "SCENE_METRICS=${scene_metrics_path}"

    if [ "$name" = "${CHOSEN_NAME}" ]; then
      echo "FPS_VALUE=${fps_value}" >> "$GITHUB_ENV"
      echo "LOAD_DURATION=${load_duration}" >> "$GITHUB_ENV"
      echo "SCENE_METRICS=${scene_metrics}" >> "$GITHUB_ENV"
      chosen_seen=true
    fi

    continue 2
  done

  echo "FPS check failed for ${url}"
  exit 1
done 3< <(scripts/ci/render-url-records "$URLS_JSON")

if [ "$chosen_seen" != "true" ]; then
  echo "Chosen FPS scenario '${CHOSEN_NAME}' was not found in ${URLS_JSON}"
  exit 1
fi

render_summary
