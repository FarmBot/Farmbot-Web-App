#!/usr/bin/env python3
import csv
import os
import sys


def required_env(name):
    value = os.environ.get(name)
    if value is None:
        print(f"{name} is required", file=sys.stderr)
        raise SystemExit(1)
    return value


chosen_metrics = required_env("CHOSEN_METRICS")
fallback = required_env("FALLBACK_FPS_VALUE")
path = f"/tmp/{chosen_metrics}.csv"

try:
    with open(path, newline="") as f:
        reader = csv.DictReader(f)
        reader.fieldnames = [
            field.strip() if field else field
            for field in (reader.fieldnames or [])
        ]
        rows = list(reader)
except FileNotFoundError:
    rows = []

values = []
for row in rows[:-1]:
    try:
        values.append(float(row["FPS"]))
    except (KeyError, TypeError, ValueError):
        pass

print(f"{values[-1]:.2f}" if values else fallback)
