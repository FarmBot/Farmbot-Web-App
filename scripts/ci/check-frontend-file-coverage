#!/usr/bin/env bash
set -euo pipefail

merge_base=$(git merge-base origin/staging HEAD 2>/dev/null) || merge_base=""
changed=""
if [ -n "$merge_base" ]; then
  changed=$(git diff --name-only "$merge_base" -- | tr '\n' ',' | sed 's/,$//')
fi

sudo docker compose run --rm \
  -e CHANGED_FILES="$changed" \
  -e CHANGED_FILES_BASE="$merge_base" \
  web bundle exec rake check_file_coverage:fe "$@"
